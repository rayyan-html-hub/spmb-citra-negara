# Neon PostgreSQL: use the pooled URL for runtime and the direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed administrator; use a strong password and keep this file out of version control.
SEED_ADMIN_EMAIL=admin@example.com
SEED_PASSWORD=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Vercel Blob private storage
BLOB_READ_WRITE_TOKEN=

# Midtrans Snap
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
